# SmartBusiness Solutions chat assistant - backend settings.
# Copy to .env and fill in. Never commit .env.

# ======================= Database (Neon Postgres) =======================
# Neon connection string, with "+psycopg2" after "postgresql" and the endpoint
# id repeated in options= (the part before the first dot of the host):
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&options=endpoint%3Dep-xxxx

# ======================= Redis =======================
# docker compose sets this to its own redis container automatically.
# On a hosted platform set it to your Redis URL (e.g. Upstash: rediss://...).
# All keys start with "chatbot:", so the Redis can be shared with other apps.
REDIS_URL=redis://redis:6379/0

# ======================= Environment =======================
# "production" = the app REFUSES TO START unless DATABASE_URL, ADMIN_API_KEY,
# SESSION_SECRET and CORS_ORIGINS are set properly, and /docs is disabled.
APP_ENV=production


# ======================= Security =======================
# Generate each with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
# ADMIN_AUTH=false -> admin console has NO login: anyone who can reach the backend URL can
#   open the dashboard, upload and DELETE documents. Only use it behind your own protection
#   (private network, VPN, or a reverse proxy with auth).
# ADMIN_AUTH=true  -> admin API needs the X-Admin-Key header = ADMIN_API_KEY (24+ chars).
ADMIN_AUTH=false
ADMIN_API_KEY=
# Signs the visitor session tokens (32+ chars in production)
SESSION_SECRET=
# Your real website and admin console addresses, comma separated. Not "*" in production.
# Example: https://www.yoursite.com,https://admin.yoursite.com
CORS_ORIGINS=

# ======================= LLM (Groq) =======================
# Key: https://console.groq.com
GROQ_API_KEY=
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_COMPLEX_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_SECONDS=25

# Optional fallback if Groq fails (timeout, 429, 5xx...): OpenRouter free models.
# Empty OPENROUTER_API_KEY = fallback off. Key: https://openrouter.ai/keys
# Models are tried in order. Free models change often: check https://openrouter.ai/models?q=free
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
#nvidia/nemotron-3.5-lightning:free,
OPENROUTER_TIMEOUT_SECONDS=20


# ======================= Answer quality / safety =======================
# Below this best-match similarity the bot says "not sure" WITHOUT calling the
# LLM. Too many false "not sure" -> lower it; off-topic answers -> raise it.
RETRIEVAL_CONFIDENCE_THRESHOLD=0.40
# basic = regex checks only (free, instant).
# nemo  = also an LLM safety check on each message (+1 small Groq call per message).
GUARDRAILS_MODE=basic

# ======================= Rate limits & spend caps =======================
RATE_LIMIT_PER_MINUTE=20
RATE_LIMIT_IP_PER_MINUTE=30
RATE_LIMIT_IP_PER_DAY=300
RATE_LIMIT_NEW_SESSION_PER_MINUTE=10
# GLOBAL daily caps across all visitors - the hard stop on your LLM bill.
DAILY_LLM_MESSAGE_CAP=3000
DAILY_TOKEN_CAP=2000000
SESSION_TTL_SECONDS=1800
SESSION_TOKEN_TTL_SECONDS=43200

# ======================= Server =======================
# uvicorn workers (each loads the ~300MB embedding model; use 1 on small hosts)
WEB_CONCURRENCY=2

# Optional: add/override model prices for the admin cost estimate.
# JSON, USD per 1M tokens: {"model-name": [input_price, output_price]}
MODEL_PRICES_JSON=
